# Secrets for the voiceagent brain. Copy to .env (gitignored) and fill in.
# Only needed for the integrations you use.

# Lepro lights (the Lepro / LampUX app), used by `python -m voiceagent lepro-login`
# LEPRO_EMAIL=you@example.com
# LEPRO_PASSWORD=
# LEPRO_REGION=eu          # eu, na, us or fe

# Anthropic API key, only if llm.provider is "anthropic" instead of claude_cli
# ANTHROPIC_API_KEY=sk-ant-...
